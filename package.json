{
  "name": "usemdr-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "security:scan": "node scripts/check-public-secrets.mjs",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test:catalog": "node --test tests/catalog-pagination.test.ts",
    "test:taxonomy": "node --test tests/catalog-taxonomy.test.ts tests/catalog-taxonomy-migration.test.ts",
    "test:finance": "node --test tests/financial-periods.test.ts",
    "test:sales": "node --test tests/admin-sales.test.ts",
    "test:integrity": "node --test tests/sales-integrity.test.ts",
    "test:time": "node --test tests/store-time.test.ts",
    "test:images": "node --test tests/image-formats.test.ts",
    "test:prefetch": "node --test tests/no-next-prefetch.test.ts",
    "test:hero": "node --test tests/hero-fade-toggle.test.ts",
    "test:analytics": "node --test tests/store-analytics.test.ts",
    "test:session": "node --test tests/admin-session-duration.test.ts",
    "test:security": "node --test tests/admin-api-security.test.ts tests/admin-audit.test.ts tests/security-headers.test.ts tests/health-route.test.ts",
    "test:storefront": "node --test tests/storefront-journey.test.ts",
    "test:motion": "node --test tests/fly-to-cart.test.ts",
    "test:all": "node --test tests/*.test.ts",
    "quality": "npm run lint && npm run typecheck && npm run test:all && npm run security:scan && npm run build"
  },
  "dependencies": {
    "@jsquash/webp": "1.5.0",
    "@supabase/supabase-js": "^2.112.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.123.0"
  }
}
